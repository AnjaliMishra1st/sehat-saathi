# Database: SQLite for quick start (Postgres in docker-compose)
DATABASE_URL=sqlite:///./sehat.db

# Gnani speech APIs. Get a key at https://app.gnani.ai/voice
# Copy this file to ".env" and paste your key. NEVER commit .env to GitHub.
GNANI_API_KEY=

# Optional: change voices (see docs.gnani.ai/api/TTS/available-voices)
# GNANI_VOICE_HI=Nalini
# GNANI_VOICE_PA=Mehuli
# GNANI_VOICE_EN=Kaveri

# Reminder behaviour
RETRY_MINUTES=10
MAX_ATTEMPTS=2
NOTIFY_AHEAD=10
ENABLE_SCHEDULER=true
TZ_NAME=Asia/Kolkata
